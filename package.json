{
  "name": "slice-flow",
  "version": "0.8.0",
  "description": "Pi package: six-phase feature development workflow (frame, architect, plan, implement in slices, verify, loop) orchestrated on top of pi-subagents",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarbasmoraes/pi-slice-flow.git"
  },
  "homepage": "https://github.com/jarbasmoraes/pi-slice-flow",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "workflow",
    "subagents"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/slice-flow.ts",
      "./extensions/web-research.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "agents": [
      "./agents"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --test",
    "web:doctor": "node scripts/web-doctor.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "playwright-core": "^1.48.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "@types/node": "^24.0.0",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "typebox": "^1.3.6"
  }
}
